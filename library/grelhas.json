{
  "_meta": {
    "nome": "Banco de Dados de Grelhas HVAC",
    "fonte": "library/grelhas.pdf",
    "versao": "1.0.0",
    "descricao": "Padrões visuais e dimensionais para reconhecimento de grelhas em plantas HVAC",
    "unidade": "mm"
  },

  "assinatura_visual": {
    "forma": "retangulo",
    "borda": "tracejada",
    "padrao_interno": "diagonal_cruzada_X",
    "cor_primaria": { "r_min": 180, "r_max": 255, "g_min": 60, "g_max": 140, "b_min": 0, "b_max": 60 },
    "indicador_fluxo": {
      "tipo": "seta",
      "cor": "verde",
      "posicao": "lateral_esquerda",
      "deflexao_simples": 1,
      "deflexao_dupla": 2
    },
    "notas": "Borda laranja/vermelho tracejada + X interno diagonal. Seta verde à esquerda indica insuflamento."
  },

  "classificacao_aspect_ratio": {
    "descricao": "AR = largura / altura do bounding box detectado",
    "classes": [
      {
        "id": "quadrada",
        "label": "Grelha Quadrada",
        "ar_min": 0.75,
        "ar_max": 1.33,
        "exemplos_mm": ["200x200", "300x300", "400x400"]
      },
      {
        "id": "retangular_baixa",
        "label": "Grelha Retangular Baixa",
        "ar_min": 1.33,
        "ar_max": 2.5,
        "exemplos_mm": ["400x200", "600x300", "500x250"]
      },
      {
        "id": "retangular_media",
        "label": "Grelha Retangular Média",
        "ar_min": 2.5,
        "ar_max": 4.0,
        "exemplos_mm": ["600x200", "800x250", "1000x300"]
      },
      {
        "id": "retangular_alta",
        "label": "Grelha Retangular Alta",
        "ar_min": 4.0,
        "ar_max": 99,
        "exemplos_mm": ["1000x200", "1200x250", "1400x300"]
      }
    ]
  },

  "matriz_dimensional": {
    "descricao": "Combinações largura x altura disponíveis no catálogo (fonte: grelhas.pdf — tabela diagonal)",
    "eixo_largura_mm": [100, 150, 200, 250, 300, 350, 400, 500, 600, 700, 800, 900, 1000, 1200, 1400, 1600, 1800, 2000],
    "eixo_altura_mm":  [50, 75, 100, 125, 150, 175, 200, 225, 250, 300, 350, 400, 500, 600, 700, 800, 900, 1000],
    "regra_disponibilidade": "largura >= altura * 1.0 (relação mínima 1:1) e largura <= altura * 20 (relação máxima 20:1)",
    "padrao_diagonal": "À medida que a altura aumenta, mais opções de largura tornam-se disponíveis — padrão observado no catálogo"
  },

  "faixas_por_area": [
    {
      "id": "mini",
      "label": "Mini",
      "area_px2_min": 0,
      "area_px2_max": 800,
      "dimensao_tipica_mm": "≤ 150x100",
      "ar_esperado": [0.75, 3.0]
    },
    {
      "id": "pequena",
      "label": "Pequena",
      "area_px2_min": 800,
      "area_px2_max": 4000,
      "dimensao_tipica_mm": "200x100 – 300x200",
      "ar_esperado": [1.0, 4.0]
    },
    {
      "id": "media",
      "label": "Média",
      "area_px2_min": 4000,
      "area_px2_max": 12000,
      "dimensao_tipica_mm": "400x200 – 700x400",
      "ar_esperado": [1.0, 5.0]
    },
    {
      "id": "grande",
      "label": "Grande",
      "area_px2_min": 12000,
      "area_px2_max": 40000,
      "dimensao_tipica_mm": "800x400 – 1200x600",
      "ar_esperado": [1.2, 8.0]
    },
    {
      "id": "extra_grande",
      "label": "Extra Grande",
      "area_px2_min": 40000,
      "area_px2_max": 999999,
      "dimensao_tipica_mm": "> 1200x700",
      "ar_esperado": [1.5, 20.0]
    }
  ],

  "distincao_componentes": {
    "descricao": "Como diferenciar grelhas de outros símbolos HVAC",
    "vs_duto":    "Duto tem borda CONTÍNUA (não tracejada) e não tem X interno",
    "vs_cassete": "Cassete é quadrado com borda contínua, sem X interno — cor cyan na planta",
    "vs_difusor": "Difusor é circular/octogonal, não retangular",
    "vs_builtin": "Built-in tem borda contínua e forma alongada — cor azul na planta"
  },

  "integracao_detector": {
    "cor_planta_hvac": "magenta",
    "rgb_referencia": { "r": 255, "g": 0, "b": 255 },
    "tipo_id": "grelha",
    "campo_classificacao": "subtipo",
    "lookup_sequence": ["area_px2 → faixa_por_area", "bounding_box_ratio → classificacao_aspect_ratio"]
  }
}
